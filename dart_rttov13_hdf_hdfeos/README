
docker build --tag hkershaw/dart-dep-external:3.0 .

  Mac silicon, to run on amd64:
  docker buildx build --platform linux/amd64 --tag hkershaw/dart-dep-external:4.0 .

tar files of src code in local directory 'target' mounted as /app

docker run -it --mount type=bind,source="$(pwd)"/target,target=/app,readonly --name lib-test hkershaw/dart-dep-external:3.0 bash

  Mac silicon:
  docker run -it --platform linux/amd64 --mount type=bind,source="$(pwd)"/target,target=/app,readonly --name lib-test hkershaw/dart-dep-external:4.0 bash

# rttov 12
cp -r /app/rttov123 . 
cd rttov123/src
edit ../build/Makefile.local (see rttov12.makefile.local)
../build/rttov_compile.sh 
gfortran

prefix:
../rttov12_lib

